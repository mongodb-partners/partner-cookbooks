{
  "name": "mongodb-mastra-cookbook",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Mastra + MongoDB Atlas notebook set for the MongoDB partner cookbooks",
  "scripts": {
    "test": "vitest run && tsx scripts/check-notebook-outputs.ts",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "check:outputs": "tsx scripts/check-notebook-outputs.ts"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.23",
    "@huggingface/transformers": "3.8.1",
    "@mastra/core": "1.53.0",
    "@mastra/memory": "1.23.1",
    "@mastra/mongodb": "1.15.0",
    "@mastra/voyageai": "0.4.0",
    "mongodb": "6.21.0",
    "onnxruntime-node": "1.27.0",
    "tslib": "2.8.1",
    "voyageai": "0.3.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "tslab": "1.0.22",
    "tsx": "4.20.6",
    "typescript": "5.9.3",
    "vitest": "3.2.6"
  },
  "overrides": {
    "sharp": "0.35.3",
    "adm-zip": "0.6.0"
  }
}
